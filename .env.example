# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/job-approvals

# Firebase Admin (server)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# Firebase Client (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local dev only — skip Firebase (set same on client)
DEV_BYPASS_AUTH=true
NEXT_PUBLIC_DEV_BYPASS_AUTH=true

# Optional: comma-separated Firebase UIDs for single-user lockdown
ALLOWED_FIREBASE_UIDS=

# Seed documented profile on bootstrap POST when true
SEED_PROFILE=true

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-20250514
CLAUDE_MODEL_LIGHT=claude-3-5-haiku-latest

# Worker (Playwright only — not used for scheduled discovery)
WORKER_API_SECRET=change-me

# External cron (cron-job.org, etc.)
CRON_SECRET=change-me-long-random
